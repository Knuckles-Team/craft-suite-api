# Optional SDK settings, loaded by the operator; no credentials are stored here.
HOST=127.0.0.1
PORT=8000
TRANSPORT=stdio
AUTH_TYPE=none
SYSTEMTOOL=True
# Set TEMPLATECONNECTOR_API_BASE_URL at runtime to the authorized service origin.
# Set TEMPLATECONNECTOR_API_TOKEN_REF to an env:// or openbao:// credential reference.
# Opt in only for an explicitly authorized HTTP origin in TEMPLATECONNECTOR_API_BASE_URL.
TEMPLATECONNECTOR_API_ALLOW_PLAINTEXT=false
# Configure TEMPLATECONNECTOR_API_TLS_PROFILE or TEMPLATECONNECTOR_API_TLS_PROFILE_REF per SDK TLS policy.
# Network exposure/authentication and token exchange remain separately authorized.
