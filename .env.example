# Optional SDK settings, loaded by the operator; no credentials are stored here.
HOST=127.0.0.1
PORT=8000
TRANSPORT=stdio
AUTH_TYPE=none
SYSTEMTOOL=True
# Set ARTCRAFT_API_BASE_URL at runtime to the authorized service origin.
# Set ARTCRAFT_API_TOKEN_REF to an env:// or openbao:// credential reference.
# Opt in only for an explicitly authorized HTTP origin in ARTCRAFT_API_BASE_URL.
ARTCRAFT_API_ALLOW_PLAINTEXT=false
# Configure ARTCRAFT_API_TLS_PROFILE or ARTCRAFT_API_TLS_PROFILE_REF per SDK TLS policy.
# Network exposure/authentication and token exchange remain separately authorized.
