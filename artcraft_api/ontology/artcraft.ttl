@prefix : <http://knuckles.team/kg#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TODO: replace this stub with the real domain model. Classes/properties live in the
# SHARED : (kg#) namespace; only the owl:Ontology node gets the per-package IRI. Do NOT
# redefine classes another package owns (:MediaAsset/:Blob/:Document/:Person) — reuse them.

:ArtcraftResource a owl:Class ;
    rdfs:label "ArtCraft Resource" ;
    rdfs:comment "A primary object managed by ArtCraft (STUB — rename/expand)." .

:managedBy a owl:ObjectProperty ;
    rdfs:label "managed by" ;
    rdfs:comment "Links a ArtCraft resource to the Person responsible (STUB)." ;
    rdfs:domain :ArtcraftResource ;
    rdfs:range :Person .

:artcraftId a owl:DatatypeProperty ;
    rdfs:label "artcraft id" ;
    rdfs:comment "External identifier of the ArtCraft resource (STUB)." ;
    rdfs:domain :ArtcraftResource ;
    rdfs:range xsd:string .

<http://knuckles.team/kg/artcraft> a owl:Ontology ;
    rdfs:label "ArtCraft Ontology" ;
    rdfs:comment "ArtCraft domain extensions federated into the KG hub. STUB." ;
    owl:imports <http://knuckles.team/kg> .
