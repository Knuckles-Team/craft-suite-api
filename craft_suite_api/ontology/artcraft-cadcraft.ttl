@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/cadcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/cadcraft> a owl:Ontology ;
    rdfs:label "cadcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "cadcraft" ;
    :appVersion "0.17.0" .

app:CadDrawing a owl:Class ;
    rdfs:label "CadDrawing" ;
    rdfs:comment "A 2D CAD drawing produced by CadCraft." ;
    rdfs:subClassOf :Document .

app:CadEntity a owl:Class ;
    rdfs:label "CadEntity" ;
    rdfs:comment "An entity inside a CadCraft drawing." ;
    rdfs:subClassOf :Artifact .

app:use_case_create_drawing a :UseCase ;
    :forApp app:app ;
    :usesToolName "cadcraft_new_drawing" ;
    :usesToolName "cadcraft_list_commands" ;
    :usesToolName "cadcraft_execute" ;
    :usesToolName "cadcraft_render" .

app:use_case_query_drawing a :UseCase ;
    :forApp app:app ;
    :usesToolName "cadcraft_inspect_drawing" ;
    :usesToolName "cadcraft_query_entities" ;
    :usesToolName "cadcraft_find_text" .

app:use_case_script_drawing a :UseCase ;
    :forApp app:app ;
    :usesToolName "cadcraft_script" ;
    :usesToolName "cadcraft_command_line" ;
    :usesToolName "cadcraft_save" .
