    :hasParameterBinding wf:effectcraft_title_card_step6_p1 ;
    :hasParameterBinding wf:effectcraft_title_card_step6_p2 ;
    :hasParameterBinding wf:effectcraft_title_card_step6_p3 ;
    :hasParameterBinding wf:effectcraft_title_card_step6_p4 .

