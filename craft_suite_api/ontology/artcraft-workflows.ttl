    :stepOrder 6 ;
    :stepToolName "solidcraft_screenshot" ;
    :stepPurpose "Render a PNG (width and height in px)." ;
    :hasParameterBinding wf:solidcraft_product_model_step6_p1 ;
    :hasParameterBinding wf:solidcraft_product_model_step6_p2 ;
    :hasParameterBinding wf:solidcraft_product_model_step6_p3 .

wf:solidcraft_product_model_step6_p1 a :ToolParameterBinding ;
