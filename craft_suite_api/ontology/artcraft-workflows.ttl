wf:solidcraft_product_model a :CraftWorkflow ;
    rdfs:label "Model a product in 3-D" ;
    rdfs:comment "Sketch a profile and revolve it into a solid product model, check its size, and export STL, STEP, a PNG render and the design file." ;
    :workflowApp <http://knuckles.team/kg/artcraft/solidcraft#app> ;
    :readsFrom wf:exchange_objects ;
    :readsFrom wf:solidcraft_session ;
    :writesTo wf:exchange_objects ;
    :writesTo wf:exchange_files ;
    :writesTo wf:solidcraft_session ;
    :outputFormat "stl" ;
    :outputFormat "step" ;
    :outputFormat "png" ;
    :outputFormat "sc" ;
    :producesAssetType :MarketingAsset ;
    :hasToolUseContract wf:solidcraft_product_model_contract .

wf:solidcraft_product_model_contract a :ToolUseContract ;
    rdfs:label "Model a product in 3-D contract" ;
    :hasToolUseStep wf:solidcraft_product_model_step1 ;
    :hasToolUseStep wf:solidcraft_product_model_step2 ;
    :hasToolUseStep wf:solidcraft_product_model_step3 ;
    :hasToolUseStep wf:solidcraft_product_model_step4 ;
    :hasToolUseStep wf:solidcraft_product_model_step5 ;
    :hasToolUseStep wf:solidcraft_product_model_step6 ;
    :hasToolUseStep wf:solidcraft_product_model_step7 .

wf:solidcraft_product_model_step1 a :ToolUseStep ;
    :stepOrder 1 ;
    :stepToolName "solidcraft_new_design" ;
    :stepPurpose "New design." ;
    :hasParameterBinding wf:solidcraft_product_model_step1_p1 .

wf:solidcraft_product_model_step1_p1 a :ToolParameterBinding ;
    :parameterName "name" ;
    :parameterValue "\"${name}\"" .

wf:solidcraft_product_model_step2 a :ToolUseStep ;
    :stepOrder 2 ;
    :stepToolName "solidcraft_batch" ;
    :stepPurpose "Sketch the half profile on XZ and revolve it 360 deg around Z in one batch (with an expected bounding box check)." ;
    :hasParameterBinding wf:solidcraft_product_model_step2_p1 ;
    :hasParameterBinding wf:solidcraft_product_model_step2_p2 .

wf:solidcraft_product_model_step2_p1 a :ToolParameterBinding ;
    :parameterName "commands" ;
    :parameterValue "[{\"command\": \"sketch.create\", \"params\": {\"plane\": \"XZ\"}}, {\"command\": \"sketch.line\", \"params\": {\"points\": [[60, 0], [57, 0], [37, -87], [15, -87], [15, -90], [40, -90]], \"closed\": true}}, {\"command\": \"solid.revolve\", \"params\": {\"axis\": \"Z\", \"angle\": \"360 deg\", \"body_name\": \"LampShade\"}}]" .

wf:solidcraft_product_model_step2_p2 a :ToolParameterBinding ;
    :parameterName "expect" ;
    :parameterValue "{\"bodies\": 1, \"bbox\": {\"min\": [-60, -60, 0], \"max\": [60, 60, 90]}}" .

wf:solidcraft_product_model_step3 a :ToolUseStep ;
    :stepOrder 3 ;
    :stepToolName "solidcraft_measure" ;
    :stepPurpose "Measure the body: bounding box, volume, faces." ;
    :hasParameterBinding wf:solidcraft_product_model_step3_p1 .

wf:solidcraft_product_model_step3_p1 a :ToolParameterBinding ;
    :parameterName "summary" ;
    :parameterValue "true" .

wf:solidcraft_product_model_step4 a :ToolUseStep ;
    :stepOrder 4 ;
    :stepToolName "solidcraft_export" ;
    :stepPurpose "Export STL for printing or texturing." ;
    :hasParameterBinding wf:solidcraft_product_model_step4_p1 .

wf:solidcraft_product_model_step4_p1 a :ToolParameterBinding ;
    :parameterName "path" ;
    :parameterValue "\"${name}.stl\"" .

wf:solidcraft_product_model_step5 a :ToolUseStep ;
    :stepOrder 5 ;
    :stepToolName "solidcraft_export" ;
    :stepPurpose "Export STEP for CAD exchange." ;
    :hasParameterBinding wf:solidcraft_product_model_step5_p1 .

wf:solidcraft_product_model_step5_p1 a :ToolParameterBinding ;
    :parameterName "path" ;
    :parameterValue "\"${name}.step\"" .

