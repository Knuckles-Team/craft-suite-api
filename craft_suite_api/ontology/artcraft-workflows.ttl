wf:effectcraft_title_card a :CraftWorkflow ;
    rdfs:label "Animate a title card" ;
    rdfs:comment "Build a 5 s animated title card (title slides and fades in, subtitle fades in) and render it to MP4, with stills and a Lottie file." ;
    :workflowApp <http://knuckles.team/kg/artcraft/effectcraft#app> ;
    :readsFrom wf:exchange_objects ;
    :readsFrom wf:effectcraft_session ;
    :writesTo wf:exchange_objects ;
    :writesTo wf:exchange_files ;
    :writesTo wf:effectcraft_session ;
    :outputFormat "mp4" ;
    :outputFormat "png" ;
    :outputFormat "json" ;
    :producesAssetType :PromoVideo ;
    :hasToolUseContract wf:effectcraft_title_card_contract .

