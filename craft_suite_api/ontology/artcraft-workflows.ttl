wf:materialcraft_product_material a :CraftWorkflow ;
    rdfs:label "Build a product material" ;
    rdfs:comment "Build a brushed-metal PBR material graph from noise, levels, a gradient map and a normal/AO node, and export its texture maps." ;
    :workflowApp <http://knuckles.team/kg/artcraft/materialcraft#app> ;
    :readsFrom wf:exchange_objects ;
    :readsFrom wf:materialcraft_session ;
    :writesTo wf:exchange_objects ;
    :writesTo wf:exchange_files ;
    :writesTo wf:materialcraft_session ;
    :outputFormat "png" ;
    :producesAssetType :MarketingAsset ;
    :hasToolUseContract wf:materialcraft_product_material_contract .

wf:materialcraft_product_material_contract a :ToolUseContract ;
    rdfs:label "Build a product material contract" ;
    :hasToolUseStep wf:materialcraft_product_material_step1 ;
    :hasToolUseStep wf:materialcraft_product_material_step2 ;
    :hasToolUseStep wf:materialcraft_product_material_step3 ;
    :hasToolUseStep wf:materialcraft_product_material_step4 ;
    :hasToolUseStep wf:materialcraft_product_material_step5 ;
    :hasToolUseStep wf:materialcraft_product_material_step6 ;
    :hasToolUseStep wf:materialcraft_product_material_step7 ;
    :hasToolUseStep wf:materialcraft_product_material_step8 ;
    :hasToolUseStep wf:materialcraft_product_material_step9 ;
    :hasToolUseStep wf:materialcraft_product_material_step10 ;
    :hasToolUseStep wf:materialcraft_product_material_step11 ;
    :hasToolUseStep wf:materialcraft_product_material_step12 ;
    :hasToolUseStep wf:materialcraft_product_material_step13 .

wf:materialcraft_product_material_step1 a :ToolUseStep ;
    :stepOrder 1 ;
    :stepToolName "materialcraft_graph_new" ;
    :stepPurpose "New PBR graph (size in px); the answer gives its index." ;
    :hasParameterBinding wf:materialcraft_product_material_step1_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step1_p2 ;
    :hasParameterBinding wf:materialcraft_product_material_step1_p3 .

wf:materialcraft_product_material_step1_p1 a :ToolParameterBinding ;
    :parameterName "name" ;
    :parameterValue "\"${name}\"" .

wf:materialcraft_product_material_step1_p2 a :ToolParameterBinding ;
    :parameterName "template" ;
    :parameterValue "\"pbr\"" .

wf:materialcraft_product_material_step1_p3 a :ToolParameterBinding ;
    :parameterName "size" ;
    :parameterValue "512" .

wf:materialcraft_product_material_step2 a :ToolUseStep ;
    :stepOrder 2 ;
    :stepToolName "materialcraft_command_batch" ;
    :stepPurpose "Set the metallic output to 1 (select the node first, then set its parameter)." ;
    :hasParameterBinding wf:materialcraft_product_material_step2_p1 .

wf:materialcraft_product_material_step2_p1 a :ToolParameterBinding ;
    :parameterName "steps" ;
    :parameterValue "[{\"id\": \"graph.select\", \"params\": {\"ids\": [1]}}, {\"id\": \"graph.node.param\", \"params\": {\"id\": 1, \"param\": \"metallic\", \"value\": 1.0}}]" .

wf:materialcraft_product_material_step3 a :ToolUseStep ;
    :stepOrder 3 ;
    :stepToolName "materialcraft_node_add" ;
    :stepPurpose "Anisotropic noise: the brushed streaks." ;
    :hasParameterBinding wf:materialcraft_product_material_step3_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step3_p2 ;
    :hasParameterBinding wf:materialcraft_product_material_step3_p3 .

wf:materialcraft_product_material_step3_p1 a :ToolParameterBinding ;
    :parameterName "def" ;
    :parameterValue "\"anisotropic_noise\"" .

wf:materialcraft_product_material_step3_p2 a :ToolParameterBinding ;
    :parameterName "params" ;
    :parameterValue "{\"scale\": 2, \"scale_y\": 300, \"smoothness\": 0.4}" .

wf:materialcraft_product_material_step3_p3 a :ToolParameterBinding ;
    :parameterName "at" ;
    :parameterValue "[-400, 0]" .

wf:materialcraft_product_material_step4 a :ToolUseStep ;
    :stepOrder 4 ;
    :stepToolName "materialcraft_node_add" ;
    :stepPurpose "Levels: the roughness range." ;
    :hasParameterBinding wf:materialcraft_product_material_step4_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step4_p2 ;
    :hasParameterBinding wf:materialcraft_product_material_step4_p3 .

wf:materialcraft_product_material_step4_p1 a :ToolParameterBinding ;
    :parameterName "def" ;
    :parameterValue "\"levels\"" .

wf:materialcraft_product_material_step4_p2 a :ToolParameterBinding ;
    :parameterName "params" ;
    :parameterValue "{\"in_low\": 0.25, \"in_high\": 0.85, \"out_low\": 0.25, \"out_high\": 0.6}" .

wf:materialcraft_product_material_step4_p3 a :ToolParameterBinding ;
    :parameterName "connectFrom" ;
    :parameterValue "{\"node\": \"${noise}\"}" .

wf:materialcraft_product_material_step5 a :ToolUseStep ;
    :stepOrder 5 ;
    :stepToolName "materialcraft_node_add" ;
    :stepPurpose "Gradient map: the metal's base colour." ;
    :hasParameterBinding wf:materialcraft_product_material_step5_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step5_p2 ;
    :hasParameterBinding wf:materialcraft_product_material_step5_p3 .

wf:materialcraft_product_material_step5_p1 a :ToolParameterBinding ;
    :parameterName "def" ;
    :parameterValue "\"gradient_map\"" .

wf:materialcraft_product_material_step5_p2 a :ToolParameterBinding ;
    :parameterName "params" ;
    :parameterValue "{\"gradient\": [[0.0, \"#7d8189\"], [1.0, \"#d8dbe0\"]]}" .

wf:materialcraft_product_material_step5_p3 a :ToolParameterBinding ;
    :parameterName "connectFrom" ;
    :parameterValue "{\"node\": \"${noise}\"}" .

wf:materialcraft_product_material_step6 a :ToolUseStep ;
    :stepOrder 6 ;
    :stepToolName "materialcraft_node_add" ;
    :stepPurpose "Height to normal and ambient occlusion." ;
    :hasParameterBinding wf:materialcraft_product_material_step6_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step6_p2 ;
    :hasParameterBinding wf:materialcraft_product_material_step6_p3 .

wf:materialcraft_product_material_step6_p1 a :ToolParameterBinding ;
    :parameterName "def" ;
    :parameterValue "\"height_normal_ao\"" .

wf:materialcraft_product_material_step6_p2 a :ToolParameterBinding ;
    :parameterName "params" ;
    :parameterValue "{\"normal_intensity\": 0.6}" .

wf:materialcraft_product_material_step6_p3 a :ToolParameterBinding ;
    :parameterName "connectFrom" ;
    :parameterValue "{\"node\": \"${noise}\"}" .

wf:materialcraft_product_material_step7 a :ToolUseStep ;
    :stepOrder 7 ;
    :stepToolName "materialcraft_node_connect" ;
    :stepPurpose "Base colour output from the gradient map." ;
    :hasParameterBinding wf:materialcraft_product_material_step7_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step7_p2 .

wf:materialcraft_product_material_step7_p1 a :ToolParameterBinding ;
    :parameterName "from" ;
    :parameterValue "\"${gm}\"" .

wf:materialcraft_product_material_step7_p2 a :ToolParameterBinding ;
    :parameterName "to" ;
    :parameterValue "2" .

wf:materialcraft_product_material_step8 a :ToolUseStep ;
    :stepOrder 8 ;
    :stepToolName "materialcraft_node_connect" ;
    :stepPurpose "Normal output." ;
    :hasParameterBinding wf:materialcraft_product_material_step8_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step8_p2 ;
    :hasParameterBinding wf:materialcraft_product_material_step8_p3 .

wf:materialcraft_product_material_step8_p1 a :ToolParameterBinding ;
    :parameterName "from" ;
    :parameterValue "\"${hn}\"" .

wf:materialcraft_product_material_step8_p2 a :ToolParameterBinding ;
    :parameterName "fromPort" ;
    :parameterValue "\"normal\"" .

wf:materialcraft_product_material_step8_p3 a :ToolParameterBinding ;
    :parameterName "to" ;
    :parameterValue "3" .

wf:materialcraft_product_material_step9 a :ToolUseStep ;
    :stepOrder 9 ;
    :stepToolName "materialcraft_node_connect" ;
    :stepPurpose "Roughness output from the levels." ;
    :hasParameterBinding wf:materialcraft_product_material_step9_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step9_p2 .

wf:materialcraft_product_material_step9_p1 a :ToolParameterBinding ;
    :parameterName "from" ;
    :parameterValue "\"${lv}\"" .

wf:materialcraft_product_material_step9_p2 a :ToolParameterBinding ;
    :parameterName "to" ;
    :parameterValue "4" .

wf:materialcraft_product_material_step10 a :ToolUseStep ;
    :stepOrder 10 ;
    :stepToolName "materialcraft_node_connect" ;
    :stepPurpose "Ambient occlusion output." ;
    :hasParameterBinding wf:materialcraft_product_material_step10_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step10_p2 ;
    :hasParameterBinding wf:materialcraft_product_material_step10_p3 .

wf:materialcraft_product_material_step10_p1 a :ToolParameterBinding ;
    :parameterName "from" ;
    :parameterValue "\"${hn}\"" .

wf:materialcraft_product_material_step10_p2 a :ToolParameterBinding ;
    :parameterName "fromPort" ;
    :parameterValue "\"ambient_occlusion\"" .

wf:materialcraft_product_material_step10_p3 a :ToolParameterBinding ;
    :parameterName "to" ;
    :parameterValue "7" .

wf:materialcraft_product_material_step11 a :ToolUseStep ;
    :stepOrder 11 ;
    :stepToolName "materialcraft_node_connect" ;
    :stepPurpose "Height output from the noise." ;
    :hasParameterBinding wf:materialcraft_product_material_step11_p1 ;
    :hasParameterBinding wf:materialcraft_product_material_step11_p2 .

wf:materialcraft_product_material_step11_p1 a :ToolParameterBinding ;
    :parameterName "from" ;
    :parameterValue "\"${noise}\"" .

wf:materialcraft_product_material_step11_p2 a :ToolParameterBinding ;
    :parameterName "to" ;
    :parameterValue "6" .

wf:materialcraft_product_material_step12 a :ToolUseStep ;
    :stepOrder 12 ;
    :stepToolName "materialcraft_outputs_export" ;
    :stepPurpose "Export every output into a folder (relative to the run)." ;
    :hasParameterBinding wf:materialcraft_product_material_step12_p1 .

wf:materialcraft_product_material_step12_p1 a :ToolParameterBinding ;
    :parameterName "dir" ;
    :parameterValue "\"${name}\"" .

wf:materialcraft_product_material_step13 a :ToolUseStep ;
    :stepOrder 13 ;
    :stepToolName "materialcraft_view_render" ;
    :stepPurpose "Render a preview." .

wf:skill_materialcraft_product_material a :CraftSkill ;
    rdfs:label "Build a product material" ;
    :skillName "materialcraft-product-material" ;
    :skillWalksWorkflow wf:materialcraft_product_material .

wf:texturecraft_texture_product a :CraftWorkflow ;
    rdfs:label "Texture a product model" ;
    rdfs:comment "Import a product mesh, paint colour and material strokes on it, render the viewport, and export PBR textures, a GLB and the project." ;
    :workflowApp <http://knuckles.team/kg/artcraft/texturecraft#app> ;
    :readsFrom wf:exchange_objects ;
    :readsFrom wf:texturecraft_session ;
    :writesTo wf:exchange_objects ;
    :writesTo wf:exchange_files ;
    :writesTo wf:texturecraft_session ;
    :outputFormat "png" ;
    :outputFormat "glb" ;
    :outputFormat "tcraft" ;
    :producesAssetType :MarketingAsset ;
    :hasToolUseContract wf:texturecraft_texture_product_contract .

wf:texturecraft_texture_product_contract a :ToolUseContract ;
    rdfs:label "Texture a product model contract" ;
    :hasToolUseStep wf:texturecraft_texture_product_step1 ;
    :hasToolUseStep wf:texturecraft_texture_product_step2 ;
    :hasToolUseStep wf:texturecraft_texture_product_step3 ;
    :hasToolUseStep wf:texturecraft_texture_product_step4 ;
    :hasToolUseStep wf:texturecraft_texture_product_step5 ;
    :hasToolUseStep wf:texturecraft_texture_product_step6 ;
    :hasToolUseStep wf:texturecraft_texture_product_step7 .

wf:texturecraft_texture_product_step1 a :ToolUseStep ;
    :stepOrder 1 ;
    :stepToolName "texturecraft_mesh_import" ;
    :stepPurpose "New project from the mesh (texture resolution in px)." ;
    :hasParameterBinding wf:texturecraft_texture_product_step1_p1 ;
    :hasParameterBinding wf:texturecraft_texture_product_step1_p2 .

wf:texturecraft_texture_product_step1_p1 a :ToolParameterBinding ;
    :parameterName "path" ;
    :parameterValue "\"${mesh}\"" .

wf:texturecraft_texture_product_step1_p2 a :ToolParameterBinding ;
    :parameterName "resolution" ;
    :parameterValue "1024" .

wf:texturecraft_texture_product_step2 a :ToolUseStep ;
    :stepOrder 2 ;
    :stepToolName "texturecraft_paint_stroke" ;
    :stepPurpose "Paint a stroke: points in viewport pixels, base colour, roughness, metallic, brush size." ;
    :hasParameterBinding wf:texturecraft_texture_product_step2_p1 ;
    :hasParameterBinding wf:texturecraft_texture_product_step2_p2 ;
    :hasParameterBinding wf:texturecraft_texture_product_step2_p3 ;
    :hasParameterBinding wf:texturecraft_texture_product_step2_p4 ;
    :hasParameterBinding wf:texturecraft_texture_product_step2_p5 .

wf:texturecraft_texture_product_step2_p1 a :ToolParameterBinding ;
    :parameterName "points" ;
    :parameterValue "[[300, 200], [500, 300], [400, 420]]" .

wf:texturecraft_texture_product_step2_p2 a :ToolParameterBinding ;
    :parameterName "color" ;
    :parameterValue "\"#c0392b\"" .

wf:texturecraft_texture_product_step2_p3 a :ToolParameterBinding ;
    :parameterName "roughness" ;
    :parameterValue "0.4" .

wf:texturecraft_texture_product_step2_p4 a :ToolParameterBinding ;
    :parameterName "metallic" ;
    :parameterValue "0.2" .

wf:texturecraft_texture_product_step2_p5 a :ToolParameterBinding ;
    :parameterName "size" ;
    :parameterValue "30" .

wf:texturecraft_texture_product_step3 a :ToolUseStep ;
    :stepOrder 3 ;
    :stepToolName "texturecraft_paint_stroke" ;
    :stepPurpose "Paint a second stroke." ;
    :hasParameterBinding wf:texturecraft_texture_product_step3_p1 ;
    :hasParameterBinding wf:texturecraft_texture_product_step3_p2 ;
    :hasParameterBinding wf:texturecraft_texture_product_step3_p3 ;
    :hasParameterBinding wf:texturecraft_texture_product_step3_p4 ;
    :hasParameterBinding wf:texturecraft_texture_product_step3_p5 .

wf:texturecraft_texture_product_step3_p1 a :ToolParameterBinding ;
    :parameterName "points" ;
    :parameterValue "[[420, 180], [480, 250], [560, 330]]" .

wf:texturecraft_texture_product_step3_p2 a :ToolParameterBinding ;
    :parameterName "color" ;
    :parameterValue "\"#f1c40f\"" .

wf:texturecraft_texture_product_step3_p3 a :ToolParameterBinding ;
    :parameterName "roughness" ;
    :parameterValue "0.3" .

wf:texturecraft_texture_product_step3_p4 a :ToolParameterBinding ;
    :parameterName "metallic" ;
    :parameterValue "0.8" .

wf:texturecraft_texture_product_step3_p5 a :ToolParameterBinding ;
    :parameterName "size" ;
    :parameterValue "25" .

wf:texturecraft_texture_product_step4 a :ToolUseStep ;
    :stepOrder 4 ;
    :stepToolName "texturecraft_viewport_render" ;
    :stepPurpose "Render the viewport to check where the paint landed." ;
    :hasParameterBinding wf:texturecraft_texture_product_step4_p1 ;
    :hasParameterBinding wf:texturecraft_texture_product_step4_p2 ;
    :hasParameterBinding wf:texturecraft_texture_product_step4_p3 ;
    :hasParameterBinding wf:texturecraft_texture_product_step4_p4 .

wf:texturecraft_texture_product_step4_p1 a :ToolParameterBinding ;
    :parameterName "width" ;
    :parameterValue "800" .

wf:texturecraft_texture_product_step4_p2 a :ToolParameterBinding ;
    :parameterName "height" ;
    :parameterValue "600" .

wf:texturecraft_texture_product_step4_p3 a :ToolParameterBinding ;
    :parameterName "yaw" ;
    :parameterValue "30" .

wf:texturecraft_texture_product_step4_p4 a :ToolParameterBinding ;
    :parameterName "pitch" ;
    :parameterValue "15" .

wf:texturecraft_texture_product_step5 a :ToolUseStep ;
    :stepOrder 5 ;
    :stepToolName "texturecraft_textures_export" ;
    :stepPurpose "Export the textures with a preset (glTF PBR Metal Roughness)." ;
    :hasParameterBinding wf:texturecraft_texture_product_step5_p1 ;
    :hasParameterBinding wf:texturecraft_texture_product_step5_p2 .

wf:texturecraft_texture_product_step5_p1 a :ToolParameterBinding ;
    :parameterName "dir" ;
    :parameterValue "\"${name}-textures\"" .

wf:texturecraft_texture_product_step5_p2 a :ToolParameterBinding ;
    :parameterName "preset" ;
    :parameterValue "\"glTF PBR Metal Roughness\"" .

wf:texturecraft_texture_product_step6 a :ToolUseStep ;
    :stepOrder 6 ;
    :stepToolName "texturecraft_mesh_export" ;
    :stepPurpose "Export the mesh as GLB with its textures embedded." ;
    :hasParameterBinding wf:texturecraft_texture_product_step6_p1 ;
    :hasParameterBinding wf:texturecraft_texture_product_step6_p2 .

wf:texturecraft_texture_product_step6_p1 a :ToolParameterBinding ;
    :parameterName "path" ;
    :parameterValue "\"${name}.glb\"" .

wf:texturecraft_texture_product_step6_p2 a :ToolParameterBinding ;
    :parameterName "format" ;
    :parameterValue "\"glb\"" .

wf:texturecraft_texture_product_step7 a :ToolUseStep ;
    :stepOrder 7 ;
    :stepToolName "texturecraft_project_save" ;
    :stepPurpose "Save the project." ;
    :hasParameterBinding wf:texturecraft_texture_product_step7_p1 .

wf:texturecraft_texture_product_step7_p1 a :ToolParameterBinding ;
    :parameterName "path" ;
    :parameterValue "\"${name}.tcraft\"" .

wf:skill_texturecraft_texture_product a :CraftSkill ;
    rdfs:label "Texture a product model" ;
    :skillName "texturecraft-texture-product" ;
    :skillWalksWorkflow wf:texturecraft_texture_product .

