@prefix : <http://knuckles.team/kg#> .
@prefix wf: <http://knuckles.team/kg/artcraft/workflows#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# The proven ArtCraft business workflows: each workflow's tool-use contract (tools, order,
# parameters), the skill and agent prompts that use it, and where its data lives. Classes are in
# artcraft-workflows-vocabulary.ttl; this module imports nothing.

<http://knuckles.team/kg/artcraft/workflows> a owl:Ontology ;
    rdfs:label "ArtCraft workflows" ;
    rdfs:comment "Tool-use contracts, skills, agent prompts and data locations of the proven ArtCraft workflows." .

wf:exchange_objects a :ExchangeSink ;
    rdfs:label "objects sink" ;
    rdfs:comment "The object-store sink of the artifact exchange: every output is published there with a signed link; inputs are read from it." ;
    :locationReference "exchange://objects/<key>" ;
    :locationSetting "SCION_EXCHANGE_FILE" .

wf:exchange_files a :ExchangeSink ;
    rdfs:label "files sink" ;
    rdfs:comment "The file-share sink of the artifact exchange: outputs land under <app>/<date>/<run>/<name> for people to open." ;
    :locationReference "exchange://files/<key>" ;
    :locationSetting "SCION_EXCHANGE_FILE" .

wf:backend_private_bucket a :BackendBucket ;
    rdfs:label "craft backend private download bucket" ;
    rdfs:comment "Media files and generation results of the craft backend, reached through the craft_suite_* tools." ;
    :locationSetting "W2L_PRIVATE_DOWNLOAD_BUCKET_NAME" .

wf:backend_public_bucket a :BackendBucket ;
    rdfs:label "craft backend public download bucket" ;
    rdfs:comment "Media files and generation results of the craft backend, reached through the craft_suite_* tools." ;
    :locationSetting "W2L_PUBLIC_DOWNLOAD_BUCKET_NAME" .

wf:backend_public_gc_bucket a :BackendBucket ;
    rdfs:label "craft backend public bucket with expiry" ;
    rdfs:comment "Media files and generation results of the craft backend, reached through the craft_suite_* tools." ;
    :locationSetting "GC_ENABLED_PUBLIC_BUCKET_NAME" .

wf:cadcraft_session a :AppSession ;
    rdfs:label "cadcraft session" ;
    rdfs:comment "The caller's pooled cadcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "cadcraft (per caller)" .

wf:deckcraft_session a :AppSession ;
    rdfs:label "deckcraft session" ;
    rdfs:comment "The caller's pooled deckcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "deckcraft (per caller)" .

wf:designcraft_session a :AppSession ;
    rdfs:label "designcraft session" ;
    rdfs:comment "The caller's pooled designcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "designcraft (per caller)" .

wf:effectcraft_session a :AppSession ;
    rdfs:label "effectcraft session" ;
    rdfs:comment "The caller's pooled effectcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "effectcraft (per caller)" .

wf:figcraft_session a :AppSession ;
    rdfs:label "figcraft session" ;
    rdfs:comment "The caller's pooled figcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "figcraft (per caller)" .

wf:filmcraft_session a :AppSession ;
    rdfs:label "filmcraft session" ;
    rdfs:comment "The caller's pooled filmcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "filmcraft (per caller)" .

wf:gridcraft_session a :AppSession ;
    rdfs:label "gridcraft session" ;
    rdfs:comment "The caller's pooled gridcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "gridcraft (per caller)" .

wf:lightcraft_session a :AppSession ;
    rdfs:label "lightcraft session" ;
    rdfs:comment "The caller's pooled lightcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "lightcraft (per caller)" .

wf:materialcraft_session a :AppSession ;
    rdfs:label "materialcraft session" ;
    rdfs:comment "The caller's pooled materialcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "materialcraft (per caller)" .

wf:pdfcraft_session a :AppSession ;
    rdfs:label "pdfcraft session" ;
    rdfs:comment "The caller's pooled pdfcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "pdfcraft (per caller)" .

wf:photocraft_session a :AppSession ;
    rdfs:label "photocraft session" ;
    rdfs:comment "The caller's pooled photocraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "photocraft (per caller)" .

wf:solidcraft_session a :AppSession ;
    rdfs:label "solidcraft session" ;
    rdfs:comment "The caller's pooled solidcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "solidcraft (per caller)" .

wf:soundcraft_session a :AppSession ;
    rdfs:label "soundcraft session" ;
    rdfs:comment "The caller's pooled soundcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "soundcraft (per caller)" .

wf:texturecraft_session a :AppSession ;
    rdfs:label "texturecraft session" ;
    rdfs:comment "The caller's pooled texturecraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "texturecraft (per caller)" .

wf:vectorcraft_session a :AppSession ;
    rdfs:label "vectorcraft session" ;
    rdfs:comment "The caller's pooled vectorcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "vectorcraft (per caller)" .

wf:wordcraft_session a :AppSession ;
    rdfs:label "wordcraft session" ;
    rdfs:comment "The caller's pooled wordcraft process: open documents and projects persist between calls of one caller." ;
    :locationReference "wordcraft (per caller)" .

wf:photocraft_edit_product_photo a :CraftWorkflow ;
    rdfs:label "Edit a product photo" ;
    rdfs:comment "Open a product photo, crop and resize it for a listing, lift exposure and saturation, add a headline, and export PNG and JPEG." ;
    :workflowApp <http://knuckles.team/kg/artcraft/photocraft#app> ;
    :readsFrom wf:exchange_objects ;
    :readsFrom wf:photocraft_session ;
    :writesTo wf:exchange_objects ;
    :writesTo wf:exchange_files ;
    :writesTo wf:photocraft_session ;
    :outputFormat "png" ;
    :outputFormat "jpg" ;
    :producesAssetType :ProductPhoto ;
    :hasToolUseContract wf:photocraft_edit_product_photo_contract .

wf:photocraft_edit_product_photo_contract a :ToolUseContract ;
    rdfs:label "Edit a product photo contract" ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step1 ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step2 ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step3 ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step4 ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step5 ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step6 ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step7 ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step8 ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step9 ;
    :hasToolUseStep wf:photocraft_edit_product_photo_step10 .

wf:photocraft_edit_product_photo_step1 a :ToolUseStep ;
    :stepOrder 1 ;
    :stepToolName "photocraft_doc_open" ;
    :stepPurpose "Open the photo; the answer gives its width and height." ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step1_p1 .

wf:photocraft_edit_product_photo_step1_p1 a :ToolParameterBinding ;
    :parameterName "path" ;
    :parameterValue "\"${photo}\"" .

wf:photocraft_edit_product_photo_step2 a :ToolUseStep ;
    :stepOrder 2 ;
    :stepToolName "photocraft_cmd_image_crop" ;
    :stepPurpose "Crop to the product (pixels from the top-left)." ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step2_p1 ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step2_p2 ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step2_p3 ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step2_p4 .

wf:photocraft_edit_product_photo_step2_p1 a :ToolParameterBinding ;
    :parameterName "x" ;
    :parameterValue "200" .

wf:photocraft_edit_product_photo_step2_p2 a :ToolParameterBinding ;
    :parameterName "y" ;
    :parameterValue "150" .

wf:photocraft_edit_product_photo_step2_p3 a :ToolParameterBinding ;
    :parameterName "width" ;
    :parameterValue "1200" .

wf:photocraft_edit_product_photo_step2_p4 a :ToolParameterBinding ;
    :parameterName "height" ;
    :parameterValue "900" .

wf:photocraft_edit_product_photo_step3 a :ToolUseStep ;
    :stepOrder 3 ;
    :stepToolName "photocraft_cmd_image_imageSize" ;
    :stepPurpose "Resize to the delivery size." ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step3_p1 ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step3_p2 .

wf:photocraft_edit_product_photo_step3_p1 a :ToolParameterBinding ;
    :parameterName "width" ;
    :parameterValue "1080" .

wf:photocraft_edit_product_photo_step3_p2 a :ToolParameterBinding ;
    :parameterName "height" ;
    :parameterValue "810" .

wf:photocraft_edit_product_photo_step4 a :ToolUseStep ;
    :stepOrder 4 ;
    :stepToolName "photocraft_cmd_image_adjustments_exposure" ;
    :stepPurpose "Lift the exposure (EV stops, -20..20)." ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step4_p1 .

wf:photocraft_edit_product_photo_step4_p1 a :ToolParameterBinding ;
    :parameterName "exposure" ;
    :parameterValue "0.6" .

wf:photocraft_edit_product_photo_step5 a :ToolUseStep ;
    :stepOrder 5 ;
    :stepToolName "photocraft_cmd_image_adjustments_hueSaturation" ;
    :stepPurpose "Raise the saturation (-100..100)." ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step5_p1 .

wf:photocraft_edit_product_photo_step5_p1 a :ToolParameterBinding ;
    :parameterName "saturation" ;
    :parameterValue "30" .

wf:photocraft_edit_product_photo_step6 a :ToolUseStep ;
    :stepOrder 6 ;
    :stepToolName "photocraft_cmd_type_create" ;
    :stepPurpose "Add the headline as a text layer (x,y is the baseline start; size in pt; color #rrggbb)." ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step6_p1 ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step6_p2 ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step6_p3 ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step6_p4 ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step6_p5 ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step6_p6 .

wf:photocraft_edit_product_photo_step6_p1 a :ToolParameterBinding ;
    :parameterName "x" ;
    :parameterValue "60" .

wf:photocraft_edit_product_photo_step6_p2 a :ToolParameterBinding ;
    :parameterName "y" ;
    :parameterValue "740" .

wf:photocraft_edit_product_photo_step6_p3 a :ToolParameterBinding ;
    :parameterName "text" ;
    :parameterValue "\"${headline}\"" .

wf:photocraft_edit_product_photo_step6_p4 a :ToolParameterBinding ;
    :parameterName "size" ;
    :parameterValue "64" .

wf:photocraft_edit_product_photo_step6_p5 a :ToolParameterBinding ;
    :parameterName "color" ;
    :parameterValue "\"#ffffff\"" .

wf:photocraft_edit_product_photo_step6_p6 a :ToolParameterBinding ;
    :parameterName "font" ;
    :parameterValue "\"DejaVu Sans\"" .

wf:photocraft_edit_product_photo_step7 a :ToolUseStep ;
    :stepOrder 7 ;
    :stepToolName "photocraft_cmd_layer_flattenImage" ;
    :stepPurpose "Flatten so the exports carry the text." .

wf:photocraft_edit_product_photo_step8 a :ToolUseStep ;
    :stepOrder 8 ;
    :stepToolName "photocraft_doc_export" ;
    :stepPurpose "Export a PNG; a relative path lands in the run folder and is published." ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step8_p1 .

wf:photocraft_edit_product_photo_step8_p1 a :ToolParameterBinding ;
    :parameterName "path" ;
    :parameterValue "\"product-edit.png\"" .

wf:photocraft_edit_product_photo_step9 a :ToolUseStep ;
    :stepOrder 9 ;
    :stepToolName "photocraft_doc_export" ;
    :stepPurpose "Export a JPEG copy the same way." ;
    :hasParameterBinding wf:photocraft_edit_product_photo_step9_p1 .

wf:photocraft_edit_product_photo_step9_p1 a :ToolParameterBinding ;
    :parameterName "path" ;
    :parameterValue "\"product-edit.jpg\"" .

wf:photocraft_edit_product_photo_step10 a :ToolUseStep ;
    :stepOrder 10 ;
    :stepToolName "photocraft_doc_close" ;
    :stepPurpose "Close the document so the session holds nothing stale." .

wf:skill_photocraft_edit_product_photo a :CraftSkill ;
    rdfs:label "Edit a product photo" ;
    :skillName "photocraft-edit-product-photo" ;
    :skillWalksWorkflow wf:photocraft_edit_product_photo .

wf:filmcraft_cut_promo_video a :CraftWorkflow ;
    rdfs:label "Cut a promo video" ;
    rdfs:comment "Import a clip, make a sequence from it, trim the head and tail, lay a title over it and export an H.264 MP4." ;
    :workflowApp <http://knuckles.team/kg/artcraft/filmcraft#app> ;
    :readsFrom wf:exchange_objects ;
    :readsFrom wf:filmcraft_session ;
    :writesTo wf:exchange_objects ;
    :writesTo wf:exchange_files ;
    :writesTo wf:filmcraft_session ;
    :outputFormat "mp4" ;
    :producesAssetType :PromoVideo ;
    :hasToolUseContract wf:filmcraft_cut_promo_video_contract .

wf:filmcraft_cut_promo_video_contract a :ToolUseContract ;
    rdfs:label "Cut a promo video contract" ;
    :hasToolUseStep wf:filmcraft_cut_promo_video_step1 ;
    :hasToolUseStep wf:filmcraft_cut_promo_video_step2 ;
    :hasToolUseStep wf:filmcraft_cut_promo_video_step3 ;
    :hasToolUseStep wf:filmcraft_cut_promo_video_step4 ;
    :hasToolUseStep wf:filmcraft_cut_promo_video_step5 ;
    :hasToolUseStep wf:filmcraft_cut_promo_video_step6 ;
    :hasToolUseStep wf:filmcraft_cut_promo_video_step7 ;
    :hasToolUseStep wf:filmcraft_cut_promo_video_step8 .

wf:filmcraft_cut_promo_video_step1 a :ToolUseStep ;
    :stepOrder 1 ;
    :stepToolName "filmcraft_cmd_file_newProject" ;
    :stepPurpose "Start a project." ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step1_p1 .

wf:filmcraft_cut_promo_video_step1_p1 a :ToolParameterBinding ;
    :parameterName "name" ;
    :parameterValue "\"${project}\"" .

wf:filmcraft_cut_promo_video_step2 a :ToolUseStep ;
    :stepOrder 2 ;
    :stepToolName "filmcraft_cmd_file_import" ;
    :stepPurpose "Import the clip; the answer names the project item." ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step2_p1 .

wf:filmcraft_cut_promo_video_step2_p1 a :ToolParameterBinding ;
    :parameterName "paths" ;
    :parameterValue "[\"${clip}\"]" .

wf:filmcraft_cut_promo_video_step3 a :ToolUseStep ;
    :stepOrder 3 ;
    :stepToolName "filmcraft_cmd_file_newSequenceFromClip" ;
    :stepPurpose "Make a sequence from the clip; the answer gives the video and audio clip ids." ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step3_p1 .

wf:filmcraft_cut_promo_video_step3_p1 a :ToolParameterBinding ;
    :parameterName "items" ;
    :parameterValue "[\"${item}\"]" .

wf:filmcraft_cut_promo_video_step4 a :ToolUseStep ;
    :stepOrder 4 ;
    :stepToolName "filmcraft_cmd_timeline_trim" ;
    :stepPurpose "Trim the head: ripple the in edge forward (delta in ticks; here 2 s), audio follows when linked." ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step4_p1 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step4_p2 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step4_p3 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step4_p4 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step4_p5 .

wf:filmcraft_cut_promo_video_step4_p1 a :ToolParameterBinding ;
    :parameterName "clip" ;
    :parameterValue "\"${vclip}\"" .

wf:filmcraft_cut_promo_video_step4_p2 a :ToolParameterBinding ;
    :parameterName "edge" ;
    :parameterValue "\"in\"" .

wf:filmcraft_cut_promo_video_step4_p3 a :ToolParameterBinding ;
    :parameterName "mode" ;
    :parameterValue "\"ripple\"" .

wf:filmcraft_cut_promo_video_step4_p4 a :ToolParameterBinding ;
    :parameterName "delta" ;
    :parameterValue "508032000000" .

wf:filmcraft_cut_promo_video_step4_p5 a :ToolParameterBinding ;
    :parameterName "linked" ;
    :parameterValue "true" .

wf:filmcraft_cut_promo_video_step5 a :ToolUseStep ;
    :stepOrder 5 ;
    :stepToolName "filmcraft_cmd_timeline_trim" ;
    :stepPurpose "Trim the tail: ripple the out edge back (here 4 s), leaving 6 s." ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step5_p1 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step5_p2 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step5_p3 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step5_p4 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step5_p5 .

wf:filmcraft_cut_promo_video_step5_p1 a :ToolParameterBinding ;
    :parameterName "clip" ;
    :parameterValue "\"${vclip}\"" .

wf:filmcraft_cut_promo_video_step5_p2 a :ToolParameterBinding ;
    :parameterName "edge" ;
    :parameterValue "\"out\"" .

wf:filmcraft_cut_promo_video_step5_p3 a :ToolParameterBinding ;
    :parameterName "mode" ;
    :parameterValue "\"ripple\"" .

wf:filmcraft_cut_promo_video_step5_p4 a :ToolParameterBinding ;
    :parameterName "delta" ;
    :parameterValue "-1016064000000" .

wf:filmcraft_cut_promo_video_step5_p5 a :ToolParameterBinding ;
    :parameterName "linked" ;
    :parameterValue "true" .

wf:filmcraft_cut_promo_video_step6 a :ToolUseStep ;
    :stepOrder 6 ;
    :stepToolName "filmcraft_cmd_graphics_newText" ;
    :stepPurpose "Add the title on the track above (position in pixels, size in px, seconds on screen, time in ticks)." ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step6_p1 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step6_p2 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step6_p3 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step6_p4 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step6_p5 .

wf:filmcraft_cut_promo_video_step6_p1 a :ToolParameterBinding ;
    :parameterName "text" ;
    :parameterValue "\"${title}\"" .

wf:filmcraft_cut_promo_video_step6_p2 a :ToolParameterBinding ;
    :parameterName "position" ;
    :parameterValue "[120, 620]" .

wf:filmcraft_cut_promo_video_step6_p3 a :ToolParameterBinding ;
    :parameterName "size" ;
    :parameterValue "72" .

wf:filmcraft_cut_promo_video_step6_p4 a :ToolParameterBinding ;
    :parameterName "seconds" ;
    :parameterValue "6" .

wf:filmcraft_cut_promo_video_step6_p5 a :ToolParameterBinding ;
    :parameterName "time" ;
    :parameterValue "0" .

wf:filmcraft_cut_promo_video_step7 a :ToolUseStep ;
    :stepOrder 7 ;
    :stepToolName "filmcraft_sequence_inspect" ;
    :stepPurpose "Check the sequence: duration, clip in/out and the title clip." .

wf:filmcraft_cut_promo_video_step8 a :ToolUseStep ;
    :stepOrder 8 ;
    :stepToolName "filmcraft_cmd_file_exportMedia" ;
    :stepPurpose "Export the MP4. The export runs as a background job; the tool waits for it and then publishes the file." ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step8_p1 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step8_p2 ;
    :hasParameterBinding wf:filmcraft_cut_promo_video_step8_p3 .

wf:filmcraft_cut_promo_video_step8_p1 a :ToolParameterBinding ;
    :parameterName "path" ;
    :parameterValue "\"promo.mp4\"" .

wf:filmcraft_cut_promo_video_step8_p2 a :ToolParameterBinding ;
    :parameterName "format" ;
    :parameterValue "\"h264\"" .

wf:filmcraft_cut_promo_video_step8_p3 a :ToolParameterBinding ;
    :parameterName "audioCodec" ;
    :parameterValue "\"aac\"" .

wf:skill_filmcraft_cut_promo_video a :CraftSkill ;
    rdfs:label "Cut a promo video" ;
    :skillName "filmcraft-cut-promo-video" ;
    :skillWalksWorkflow wf:filmcraft_cut_promo_video .

wf:designcraft_social_post a :CraftWorkflow ;
    rdfs:label "Design a social post" ;
    rdfs:comment "Lay out a square social post with a brand background, the product photo and a headline, and export a 1080 x 1080 PNG." ;
    :workflowApp <http://knuckles.team/kg/artcraft/designcraft#app> ;
    :readsFrom wf:exchange_objects ;
    :readsFrom wf:designcraft_session ;
    :writesTo wf:exchange_objects ;
    :writesTo wf:exchange_files ;
    :writesTo wf:designcraft_session ;
    :outputFormat "png" ;
    :producesAssetType :MarketingAsset ;
    :hasToolUseContract wf:designcraft_social_post_contract .

wf:designcraft_social_post_contract a :ToolUseContract ;
    rdfs:label "Design a social post contract" ;
    :hasToolUseStep wf:designcraft_social_post_step1 ;
    :hasToolUseStep wf:designcraft_social_post_step2 ;
    :hasToolUseStep wf:designcraft_social_post_step3 ;
    :hasToolUseStep wf:designcraft_social_post_step4 ;
    :hasToolUseStep wf:designcraft_social_post_step5 ;
    :hasToolUseStep wf:designcraft_social_post_step6 ;
    :hasToolUseStep wf:designcraft_social_post_step7 ;
    :hasToolUseStep wf:designcraft_social_post_step8 ;
    :hasToolUseStep wf:designcraft_social_post_step9 ;
    :hasToolUseStep wf:designcraft_social_post_step10 .

wf:designcraft_social_post_step1 a :ToolUseStep ;
    :stepOrder 1 ;
    :stepToolName "designcraft_new_document" ;
    :stepPurpose "New web document, 540 x 540 pt (1080 px at scale 2), no margins." ;
    :hasParameterBinding wf:designcraft_social_post_step1_p1 ;
    :hasParameterBinding wf:designcraft_social_post_step1_p2 ;
    :hasParameterBinding wf:designcraft_social_post_step1_p3 ;
    :hasParameterBinding wf:designcraft_social_post_step1_p4 .

wf:designcraft_social_post_step1_p1 a :ToolParameterBinding ;
    :parameterName "width" ;
    :parameterValue "540" .

wf:designcraft_social_post_step1_p2 a :ToolParameterBinding ;
    :parameterName "height" ;
    :parameterValue "540" .

wf:designcraft_social_post_step1_p3 a :ToolParameterBinding ;
    :parameterName "intent" ;
    :parameterValue "\"web\"" .

wf:designcraft_social_post_step1_p4 a :ToolParameterBinding ;
    :parameterName "margins" ;
    :parameterValue "0" .

wf:designcraft_social_post_step2 a :ToolUseStep ;
    :stepOrder 2 ;
    :stepToolName "designcraft_cmd_frame_create" ;
    :stepPurpose "Draw the background frame over the whole page; the answer gives its id." ;
    :hasParameterBinding wf:designcraft_social_post_step2_p1 ;
    :hasParameterBinding wf:designcraft_social_post_step2_p2 ;
    :hasParameterBinding wf:designcraft_social_post_step2_p3 .

wf:designcraft_social_post_step2_p1 a :ToolParameterBinding ;
    :parameterName "rect" ;
    :parameterValue "[0, 0, 540, 540]" .

wf:designcraft_social_post_step2_p2 a :ToolParameterBinding ;
    :parameterName "shape" ;
    :parameterValue "\"rectangle\"" .

wf:designcraft_social_post_step2_p3 a :ToolParameterBinding ;
    :parameterName "content" ;
    :parameterValue "\"unassigned\"" .

wf:designcraft_social_post_step3 a :ToolUseStep ;
    :stepOrder 3 ;
    :stepToolName "designcraft_cmd_object_color" ;
    :stepPurpose "Fill it with the brand colour." ;
    :hasParameterBinding wf:designcraft_social_post_step3_p1 ;
    :hasParameterBinding wf:designcraft_social_post_step3_p2 ;
    :hasParameterBinding wf:designcraft_social_post_step3_p3 .

wf:designcraft_social_post_step3_p1 a :ToolParameterBinding ;
