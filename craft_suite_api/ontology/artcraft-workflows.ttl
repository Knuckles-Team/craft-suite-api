wf:gridcraft_price_list a :CraftWorkflow ;
    rdfs:label "Build a price list" ;
    rdfs:comment "Build a product price list with formula columns, currency formats and a chart, and save it as XLSX and CSV." ;
    :workflowApp <http://knuckles.team/kg/artcraft/gridcraft#app> ;
    :readsFrom wf:exchange_objects ;
    :readsFrom wf:gridcraft_session ;
    :writesTo wf:exchange_objects ;
    :writesTo wf:exchange_files ;
    :writesTo wf:gridcraft_session ;
    :outputFormat "xlsx" ;
    :outputFormat "csv" ;
    :producesAssetType :MarketingAsset ;
    :hasToolUseContract wf:gridcraft_price_list_contract .

wf:gridcraft_price_list_contract a :ToolUseContract ;
    rdfs:label "Build a price list contract" ;
    :hasToolUseStep wf:gridcraft_price_list_step1 ;
    :hasToolUseStep wf:gridcraft_price_list_step2 ;
    :hasToolUseStep wf:gridcraft_price_list_step3 ;
    :hasToolUseStep wf:gridcraft_price_list_step4 ;
    :hasToolUseStep wf:gridcraft_price_list_step5 ;
    :hasToolUseStep wf:gridcraft_price_list_step6 ;
    :hasToolUseStep wf:gridcraft_price_list_step7 ;
    :hasToolUseStep wf:gridcraft_price_list_step8 ;
    :hasToolUseStep wf:gridcraft_price_list_step9 ;
    :hasToolUseStep wf:gridcraft_price_list_step10 ;
    :hasToolUseStep wf:gridcraft_price_list_step11 ;
    :hasToolUseStep wf:gridcraft_price_list_step12 .

wf:gridcraft_price_list_step1 a :ToolUseStep ;
    :stepOrder 1 ;
    :stepToolName "gridcraft_new_workbook" ;
    :stepPurpose "New workbook." .

wf:gridcraft_price_list_step2 a :ToolUseStep ;
    :stepOrder 2 ;
    :stepToolName "gridcraft_write_range" ;
    :stepPurpose "Write the table from A1; strings that start with = are formulas." ;
    :hasParameterBinding wf:gridcraft_price_list_step2_p1 ;
    :hasParameterBinding wf:gridcraft_price_list_step2_p2 .

wf:gridcraft_price_list_step2_p1 a :ToolParameterBinding ;
    :parameterName "range" ;
    :parameterValue "\"A1\"" .

wf:gridcraft_price_list_step2_p2 a :ToolParameterBinding ;
    :parameterName "values" ;
    :parameterValue "[[\"SKU\", \"Product\", \"Unit Cost\", \"Markup %\", \"Price\", \"Stock\", \"Stock Value\"], [\"EL-001\", \"Ember Lamp\", 22, 0.5, \"=C2*(1+D2)\", 40, \"=E2*F2\"], [\"EL-002\", \"Ember Lamp Mini\", 14, 0.5, \"=C3*(1+D3)\", 75, \"=E3*F3\"], [\"EL-003\", \"Ember Shade\", 6, 0.8, \"=C4*(1+D4)\", 120, \"=E4*F4\"], [\"EL-004\", \"Ember Stand\", 9, 0.6, \"=C5*(1+D5)\", 60, \"=E5*F5\"], [\"\", \"Total\", \"\", \"\", \"\", \"=SUM(F2:F5)\", \"=SUM(G2:G5)\"]]" .

wf:gridcraft_price_list_step3 a :ToolUseStep ;
    :stepOrder 3 ;
    :stepToolName "gridcraft_format_range" ;
    :stepPurpose "Bold and shade the header row." ;
    :hasParameterBinding wf:gridcraft_price_list_step3_p1 ;
    :hasParameterBinding wf:gridcraft_price_list_step3_p2 ;
    :hasParameterBinding wf:gridcraft_price_list_step3_p3 .

wf:gridcraft_price_list_step3_p1 a :ToolParameterBinding ;
    :parameterName "range" ;
    :parameterValue "\"A1:G1\"" .

wf:gridcraft_price_list_step3_p2 a :ToolParameterBinding ;
    :parameterName "bold" ;
    :parameterValue "true" .

wf:gridcraft_price_list_step3_p3 a :ToolParameterBinding ;
    :parameterName "fillColor" ;
    :parameterValue "\"#DDEEFF\"" .

wf:gridcraft_price_list_step4 a :ToolUseStep ;
    :stepOrder 4 ;
    :stepToolName "gridcraft_format_range" ;
    :stepPurpose "Currency format for unit cost." ;
    :hasParameterBinding wf:gridcraft_price_list_step4_p1 ;
    :hasParameterBinding wf:gridcraft_price_list_step4_p2 .

wf:gridcraft_price_list_step4_p1 a :ToolParameterBinding ;
    :parameterName "range" ;
    :parameterValue "\"C2:C5\"" .

wf:gridcraft_price_list_step4_p2 a :ToolParameterBinding ;
    :parameterName "numberFormat" ;
    :parameterValue "\"Currency\"" .

wf:gridcraft_price_list_step5 a :ToolUseStep ;
    :stepOrder 5 ;
    :stepToolName "gridcraft_format_range" ;
    :stepPurpose "Currency format for price." ;
    :hasParameterBinding wf:gridcraft_price_list_step5_p1 ;
    :hasParameterBinding wf:gridcraft_price_list_step5_p2 .

wf:gridcraft_price_list_step5_p1 a :ToolParameterBinding ;
    :parameterName "range" ;
    :parameterValue "\"E2:E5\"" .

wf:gridcraft_price_list_step5_p2 a :ToolParameterBinding ;
    :parameterName "numberFormat" ;
    :parameterValue "\"Currency\"" .

wf:gridcraft_price_list_step6 a :ToolUseStep ;
    :stepOrder 6 ;
    :stepToolName "gridcraft_format_range" ;
    :stepPurpose "Currency format for stock value and total." ;
    :hasParameterBinding wf:gridcraft_price_list_step6_p1 ;
    :hasParameterBinding wf:gridcraft_price_list_step6_p2 .

wf:gridcraft_price_list_step6_p1 a :ToolParameterBinding ;
    :parameterName "range" ;
    :parameterValue "\"G2:G6\"" .

wf:gridcraft_price_list_step6_p2 a :ToolParameterBinding ;
    :parameterName "numberFormat" ;
    :parameterValue "\"Currency\"" .

wf:gridcraft_price_list_step7 a :ToolUseStep ;
    :stepOrder 7 ;
    :stepToolName "gridcraft_format_range" ;
    :stepPurpose "Percent format for markup." ;
    :hasParameterBinding wf:gridcraft_price_list_step7_p1 ;
    :hasParameterBinding wf:gridcraft_price_list_step7_p2 .

wf:gridcraft_price_list_step7_p1 a :ToolParameterBinding ;
    :parameterName "range" ;
    :parameterValue "\"D2:D5\"" .

wf:gridcraft_price_list_step7_p2 a :ToolParameterBinding ;
    :parameterName "numberFormat" ;
    :parameterValue "\"0%\"" .

wf:gridcraft_price_list_step8 a :ToolUseStep ;
    :stepOrder 8 ;
    :stepToolName "gridcraft_insert_chart" ;
    :stepPurpose "Insert a column chart (a range list like B1:B5,E1:E5 picks non-adjacent columns; at is the anchor cell)." ;
    :hasParameterBinding wf:gridcraft_price_list_step8_p1 ;
    :hasParameterBinding wf:gridcraft_price_list_step8_p2 ;
    :hasParameterBinding wf:gridcraft_price_list_step8_p3 ;
