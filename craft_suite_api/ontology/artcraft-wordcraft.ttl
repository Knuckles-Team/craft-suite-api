@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/wordcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/wordcraft> a owl:Ontology ;
    rdfs:label "wordcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "wordcraft" ;
    :appVersion "0.15.1" .

app:WordDocument a owl:Class ;
    rdfs:label "WordDocument" ;
    rdfs:comment "A word-processor document edited by WordCraft." ;
    rdfs:subClassOf :CreativeWork .

app:use_case_write_document a :UseCase ;
    :forApp app:app ;
    :usesToolName "wordcraft_new_document" ;
    :usesToolName "wordcraft_type_text" ;
    :usesToolName "wordcraft_select_text" ;
    :usesToolName "wordcraft_save_document" .

app:use_case_format_document a :UseCase ;
    :forApp app:app ;
    :usesToolName "wordcraft_inspect_document" ;
    :usesToolName "wordcraft_list_commands" ;
    :usesToolName "wordcraft_execute" ;
    :usesToolName "wordcraft_render_page" .

app:use_case_open_and_review a :UseCase ;
    :forApp app:app ;
    :usesToolName "wordcraft_open_document" ;
    :usesToolName "wordcraft_get_text" ;
    :usesToolName "wordcraft_save_document" .
