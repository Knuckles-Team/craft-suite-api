@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/soundcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/soundcraft> a owl:Ontology ;
    rdfs:label "soundcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "soundcraft" ;
    :appVersion "0.17.0" .

app:SoundSession a owl:Class ;
    rdfs:label "SoundSession" ;
    rdfs:comment "An audio mixing session managed by SoundCraft." ;
    rdfs:subClassOf :CreativeWork .

app:use_case_mix_session a :UseCase ;
    :forApp app:app ;
    :usesToolName "soundcraft_new_session" ;
    :usesToolName "soundcraft_inspect_session" ;
    :usesToolName "soundcraft_bounce_mix" .

app:use_case_import_and_save a :UseCase ;
    :forApp app:app ;
    :usesToolName "soundcraft_import_audio" ;
    :usesToolName "soundcraft_save_session" .

app:use_case_edit_session a :UseCase ;
    :forApp app:app ;
    :usesToolName "soundcraft_list_commands" ;
    :usesToolName "soundcraft_execute" ;
    :usesToolName "soundcraft_inspect_session" .
