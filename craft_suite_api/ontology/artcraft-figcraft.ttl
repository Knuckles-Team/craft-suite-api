@prefix : <https://knuckles-team.github.io/ontology/connector/craft-common#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix app: <https://knuckles-team.github.io/ontology/connector/figcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://knuckles-team.github.io/ontology/connector/figcraft> a owl:Ontology ;
    rdfs:label "figcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <https://knuckles-team.github.io/ontology/connector/craft-common> .

app:app a :App ;
    :appNamespace "figcraft" ;
    :appVersion "0.15.0" .

app:FigDocument a owl:Class ;
    rdfs:label "FigDocument" ;
    rdfs:comment "A figure design document edited by FigCraft." ;
    rdfs:subClassOf core:CreativeWork .

app:FigLayer a owl:Class ;
    rdfs:label "FigLayer" ;
    rdfs:comment "A layer inside a FigCraft document." ;
    rdfs:subClassOf core:Artifact .

app:use_case_create_figure a :UseCase ;
    :forApp app:app ;
    :usesToolName "figcraft_inspect_document" ;
    :usesToolName "figcraft_create_node" ;
    :usesToolName "figcraft_set_properties" ;
    :usesToolName "figcraft_save_file" .

app:use_case_edit_layers a :UseCase ;
    :forApp app:app ;
    :usesToolName "figcraft_get_node" ;
    :usesToolName "figcraft_select" ;
    :usesToolName "figcraft_set_properties" ;
    :usesToolName "figcraft_screenshot" .

app:use_case_batch_edits a :UseCase ;
    :forApp app:app ;
    :usesToolName "figcraft_list_commands" ;
    :usesToolName "figcraft_run_command" ;
    :usesToolName "figcraft_batch" ;
    :usesToolName "figcraft_undo" .
