@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/effectcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/effectcraft> a owl:Ontology ;
    rdfs:label "effectcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "effectcraft" ;
    :appVersion "0.21.0" .

app:EffectProject a owl:Class ;
    rdfs:label "EffectProject" ;
    rdfs:comment "A motion-graphics project edited by EffectCraft." ;
    rdfs:subClassOf :CreativeWork .

app:EffectComposition a owl:Class ;
    rdfs:label "EffectComposition" ;
    rdfs:comment "A composition inside an EffectCraft project." ;
    rdfs:subClassOf :CreativeWork .

app:use_case_build_composition a :UseCase ;
    :forApp app:app ;
    :usesToolName "effectcraft_open_project" ;
    :usesToolName "effectcraft_get_comp" ;
    :usesToolName "effectcraft_add_effect" ;
    :usesToolName "effectcraft_render_frame" .

app:use_case_keyframe_property a :UseCase ;
    :forApp app:app ;
    :usesToolName "effectcraft_get_layer" ;
    :usesToolName "effectcraft_get_property" ;
    :usesToolName "effectcraft_add_keyframe" ;
    :usesToolName "effectcraft_set_property" .

app:use_case_script_project a :UseCase ;
    :forApp app:app ;
    :usesToolName "effectcraft_list_commands" ;
    :usesToolName "effectcraft_execute_command" ;
    :usesToolName "effectcraft_run_script" ;
    :usesToolName "effectcraft_save_project" .
