@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/pdfcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/pdfcraft> a owl:Ontology ;
    rdfs:label "pdfcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "pdfcraft" ;
    :appVersion "0.18.1" .

app:PdfDocument a owl:Class ;
    rdfs:label "PdfDocument" ;
    rdfs:comment "A PDF document processed by PdfCraft." ;
    rdfs:subClassOf :Document .

app:PdfForm a owl:Class ;
    rdfs:label "PdfForm" ;
    rdfs:comment "A fillable PDF form inside a PdfCraft document." ;
    rdfs:subClassOf :Document .

app:use_case_edit_pdf a :UseCase ;
    :forApp app:app ;
    :usesToolName "pdfcraft_doc_inspect" ;
    :usesToolName "pdfcraft_command_list" ;
    :usesToolName "pdfcraft_command_run" ;
    :usesToolName "pdfcraft_render_preview" .

app:use_case_fill_form a :UseCase ;
    :forApp app:app ;
    :usesToolName "pdfcraft_form_detect_fields" ;
    :usesToolName "pdfcraft_form_fields" ;
    :usesToolName "pdfcraft_form_fill" ;
    :usesToolName "pdfcraft_form_reset" .

app:use_case_redact_document a :UseCase ;
    :forApp app:app ;
    :usesToolName "pdfcraft_redact_mark" ;
    :usesToolName "pdfcraft_redact_apply" ;
    :usesToolName "pdfcraft_doc_audit_redactions" .

app:use_case_extract_content a :UseCase ;
    :forApp app:app ;
    :usesToolName "pdfcraft_text_extract" ;
    :usesToolName "pdfcraft_page_extract" ;
    :usesToolName "pdfcraft_doc_export_text" .

app:use_case_add_bookmarks a :UseCase ;
    :forApp app:app ;
    :usesToolName "pdfcraft_bookmark_list" ;
    :usesToolName "pdfcraft_bookmark_add" ;
    :usesToolName "pdfcraft_bookmark_set_page" .

app:use_case_recognize_scans a :UseCase ;
    :forApp app:app ;
    :usesToolName "pdfcraft_ocr_status" ;
    :usesToolName "pdfcraft_ocr_recognize" ;
    :usesToolName "pdfcraft_text_extract" .
