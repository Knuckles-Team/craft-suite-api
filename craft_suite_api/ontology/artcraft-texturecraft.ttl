@prefix : <https://knuckles-team.github.io/ontology/connector/craft-common#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix app: <https://knuckles-team.github.io/ontology/connector/texturecraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://knuckles-team.github.io/ontology/connector/texturecraft> a owl:Ontology ;
    rdfs:label "texturecraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <https://knuckles-team.github.io/ontology/connector/craft-common> .

app:app a :App ;
    :appNamespace "texturecraft" ;
    :appVersion "0.3.2" .

app:TextureProject a owl:Class ;
    rdfs:label "TextureProject" ;
    rdfs:comment "A TextureCraft texture painting project." ;
    rdfs:subClassOf core:Document .

app:TextureSet a owl:Class ;
    rdfs:label "TextureSet" ;
    rdfs:comment "A texture set painted on a mesh in TextureCraft." ;
    rdfs:subClassOf core:Artifact .

app:use_case_paint_mesh a :UseCase ;
    :forApp app:app ;
    :usesToolName "texturecraft_project_new" ;
    :usesToolName "texturecraft_mesh_import" ;
    :usesToolName "texturecraft_bake" ;
    :usesToolName "texturecraft_paint_stroke" ;
    :usesToolName "texturecraft_project_save" .

app:use_case_export_textures a :UseCase ;
    :forApp app:app ;
    :usesToolName "texturecraft_project_open" ;
    :usesToolName "texturecraft_viewport_render" ;
    :usesToolName "texturecraft_textures_export" ;
    :usesToolName "texturecraft_mesh_export" .

app:use_case_run_commands a :UseCase ;
    :forApp app:app ;
    :usesToolName "texturecraft_command_list" ;
    :usesToolName "texturecraft_command_run" ;
    :usesToolName "texturecraft_command_batch" ;
    :usesToolName "texturecraft_session_inspect" .
