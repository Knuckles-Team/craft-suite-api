@prefix : <https://knuckles-team.github.io/ontology/connector/craft-common#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix app: <https://knuckles-team.github.io/ontology/connector/vectorcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://knuckles-team.github.io/ontology/connector/vectorcraft> a owl:Ontology ;
    rdfs:label "vectorcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <https://knuckles-team.github.io/ontology/connector/craft-common> .

app:app a :App ;
    :appNamespace "vectorcraft" ;
    :appVersion "0.21.0" .

app:VectorDocument a owl:Class ;
    rdfs:label "VectorDocument" ;
    rdfs:comment "A vector illustration document edited by VectorCraft." ;
    rdfs:subClassOf core:CreativeWork .

app:use_case_create_illustration a :UseCase ;
    :forApp app:app ;
    :usesToolName "vectorcraft_inspect_document" ;
    :usesToolName "vectorcraft_draw_shape" ;
    :usesToolName "vectorcraft_draw_path" ;
    :usesToolName "vectorcraft_set_paint" ;
    :usesToolName "vectorcraft_save_file" .

app:use_case_edit_selection a :UseCase ;
    :forApp app:app ;
    :usesToolName "vectorcraft_select_tool" ;
    :usesToolName "vectorcraft_pathfinder" ;
    :usesToolName "vectorcraft_transform" ;
    :usesToolName "vectorcraft_undo" ;
    :usesToolName "vectorcraft_redo" .

app:use_case_export_artwork a :UseCase ;
    :forApp app:app ;
    :usesToolName "vectorcraft_inspect_document" ;
    :usesToolName "vectorcraft_export" ;
    :usesToolName "vectorcraft_render_preview" ;
    :usesToolName "vectorcraft_screenshot" .
