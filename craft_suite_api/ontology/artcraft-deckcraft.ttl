@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/deckcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/deckcraft> a owl:Ontology ;
    rdfs:label "deckcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "deckcraft" ;
    :appVersion "0.15.0" .

app:DeckPresentation a owl:Class ;
    rdfs:label "DeckPresentation" ;
    rdfs:comment "A presentation edited by DeckCraft." ;
    rdfs:subClassOf :CreativeWork .

app:DeckSlide a owl:Class ;
    rdfs:label "DeckSlide" ;
    rdfs:comment "A slide inside a DeckCraft presentation." ;
    rdfs:subClassOf :Document .

app:use_case_build_deck a :UseCase ;
    :forApp app:app ;
    :usesToolName "deckcraft_new_presentation" ;
    :usesToolName "deckcraft_add_slide" ;
    :usesToolName "deckcraft_add_text_box" ;
    :usesToolName "deckcraft_save_presentation" .

app:use_case_insert_content a :UseCase ;
    :forApp app:app ;
    :usesToolName "deckcraft_inspect_document" ;
    :usesToolName "deckcraft_add_shape" ;
    :usesToolName "deckcraft_insert_chart" ;
    :usesToolName "deckcraft_insert_table" .

app:use_case_export_deck a :UseCase ;
    :forApp app:app ;
    :usesToolName "deckcraft_render_slide" ;
    :usesToolName "deckcraft_export" ;
    :usesToolName "deckcraft_save_presentation" .
