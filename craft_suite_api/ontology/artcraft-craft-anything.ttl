@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/craft-anything#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/craft-anything> a owl:Ontology ;
    rdfs:label "craft-anything" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "craftanything" ;
    :appVersion "0.6.1" .

app:Investigation a owl:Class ;
    rdfs:label "Investigation" ;
    rdfs:comment "A Craft Anything investigation project, holding the brief, plan, open targets, evidence, findings and the append-only journal." ;
    rdfs:subClassOf :CreativeWork .

app:use_case_open_investigation a :UseCase ;
    :forApp app:app ;
    :usesToolName "craftanything_core_brief_write" ;
    :usesToolName "craftanything_core_plan_update" ;
    :usesToolName "craftanything_core_targets_list" ;
    :usesToolName "craftanything_core_target_select" ;
    :usesToolName "craftanything_core_investigation_show" .

app:use_case_gather_evidence a :UseCase ;
    :forApp app:app ;
    :usesToolName "craftanything_core_evidence_show" ;
    :usesToolName "craftanything_core_evidence_browse" ;
    :usesToolName "craftanything_core_unknowns_show" ;
    :usesToolName "craftanything_core_unknown_add" ;
    :usesToolName "craftanything_core_finding_record" .

app:use_case_write_report a :UseCase ;
    :forApp app:app ;
    :usesToolName "craftanything_core_report_write" ;
    :usesToolName "craftanything_core_report_save" ;
    :usesToolName "craftanything_core_handoff_write" .
