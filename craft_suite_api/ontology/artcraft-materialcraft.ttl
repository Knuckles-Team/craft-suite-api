@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/materialcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/materialcraft> a owl:Ontology ;
    rdfs:label "materialcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "materialcraft" ;
    :appVersion "0.1.2" .

app:MaterialPackage a owl:Class ;
    rdfs:label "MaterialPackage" ;
    rdfs:comment "A material package holding MaterialCraft graphs." ;
    rdfs:subClassOf :Document .

app:MaterialGraph a owl:Class ;
    rdfs:label "MaterialGraph" ;
    rdfs:comment "A node graph inside a MaterialCraft package." ;
    rdfs:subClassOf :Artifact .

app:use_case_build_material a :UseCase ;
    :forApp app:app ;
    :usesToolName "materialcraft_graph_new" ;
    :usesToolName "materialcraft_library_list" ;
    :usesToolName "materialcraft_node_add" ;
    :usesToolName "materialcraft_node_connect" ;
    :usesToolName "materialcraft_node_param" .

app:use_case_export_material a :UseCase ;
    :forApp app:app ;
    :usesToolName "materialcraft_package_open" ;
    :usesToolName "materialcraft_view_render" ;
    :usesToolName "materialcraft_outputs_export" ;
    :usesToolName "materialcraft_package_save" .

app:use_case_run_commands a :UseCase ;
    :forApp app:app ;
    :usesToolName "materialcraft_command_list" ;
    :usesToolName "materialcraft_command_run" ;
    :usesToolName "materialcraft_command_batch" ;
    :usesToolName "materialcraft_session_inspect" .
