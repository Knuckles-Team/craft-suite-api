@prefix : <https://knuckles-team.github.io/ontology/connector/craft-common#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix app: <https://knuckles-team.github.io/ontology/connector/photocraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://knuckles-team.github.io/ontology/connector/photocraft> a owl:Ontology ;
    rdfs:label "photocraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <https://knuckles-team.github.io/ontology/connector/craft-common> .

app:app a :App ;
    :appNamespace "photocraft" ;
    :appVersion "0.20.1" .

app:PhotoDocument a owl:Class ;
    rdfs:label "PhotoDocument" ;
    rdfs:comment "A raster image document edited by PhotoCraft." ;
    rdfs:subClassOf core:CreativeWork .

app:PhotoDataSet a owl:Class ;
    rdfs:label "PhotoDataSet" ;
    rdfs:comment "A flattened data set exported from a PhotoCraft document." ;
    rdfs:subClassOf core:Document .

app:use_case_edit_image a :UseCase ;
    :forApp app:app ;
    :usesToolName "photocraft_doc_open" ;
    :usesToolName "photocraft_doc_inspect" ;
    :usesToolName "photocraft_command_list" ;
    :usesToolName "photocraft_command_run" ;
    :usesToolName "photocraft_doc_save" .

app:use_case_export_document a :UseCase ;
    :forApp app:app ;
    :usesToolName "photocraft_doc_inspect" ;
    :usesToolName "photocraft_doc_export" ;
    :usesToolName "photocraft_doc_export_layers" ;
    :usesToolName "photocraft_jobs_list" .

app:use_case_inspect_session a :UseCase ;
    :forApp app:app ;
    :usesToolName "photocraft_session_list" ;
    :usesToolName "photocraft_doc_select" ;
    :usesToolName "photocraft_doc_inspect" .
