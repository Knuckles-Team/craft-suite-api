@prefix : <https://knuckles-team.github.io/ontology/connector/craft-common#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix app: <https://knuckles-team.github.io/ontology/connector/solidcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://knuckles-team.github.io/ontology/connector/solidcraft> a owl:Ontology ;
    rdfs:label "solidcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <https://knuckles-team.github.io/ontology/connector/craft-common> .

app:app a :App ;
    :appNamespace "solidcraft" ;
    :appVersion "0.40.0-rc.2" .

app:SolidDesign a owl:Class ;
    rdfs:label "SolidDesign" ;
    rdfs:comment "A parametric 3D design file produced by SolidCraft." ;
    rdfs:subClassOf core:Artifact .

app:SolidBody a owl:Class ;
    rdfs:label "SolidBody" ;
    rdfs:comment "A body inside a SolidCraft design." ;
    rdfs:subClassOf core:Artifact .

app:use_case_model_body a :UseCase ;
    :forApp app:app ;
    :usesToolName "solidcraft_new_design" ;
    :usesToolName "solidcraft_list_commands" ;
    :usesToolName "solidcraft_execute" ;
    :usesToolName "solidcraft_screenshot" .

app:use_case_parameterize_design a :UseCase ;
    :forApp app:app ;
    :usesToolName "solidcraft_set_parameter" ;
    :usesToolName "solidcraft_check_parameters" ;
    :usesToolName "solidcraft_inspect_design" .

app:use_case_export_model a :UseCase ;
    :forApp app:app ;
    :usesToolName "solidcraft_measure" ;
    :usesToolName "solidcraft_body_topology" ;
    :usesToolName "solidcraft_export" .
