@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/designcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/designcraft> a owl:Ontology ;
    rdfs:label "designcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "designcraft" ;
    :appVersion "0.17.2" .

app:LayoutDocument a owl:Class ;
    rdfs:label "LayoutDocument" ;
    rdfs:comment "A page layout document produced by DesignCraft." ;
    rdfs:subClassOf :Document .

app:LayoutStory a owl:Class ;
    rdfs:label "LayoutStory" ;
    rdfs:comment "A text story threaded through frames of a DesignCraft document." ;
    rdfs:subClassOf :Artifact .

app:use_case_lay_out_document a :UseCase ;
    :forApp app:app ;
    :usesToolName "designcraft_new_document" ;
    :usesToolName "designcraft_place_image" ;
    :usesToolName "designcraft_set_story_text" ;
    :usesToolName "designcraft_save_document" .

app:use_case_inspect_document a :UseCase ;
    :forApp app:app ;
    :usesToolName "designcraft_open_document" ;
    :usesToolName "designcraft_inspect_document" ;
    :usesToolName "designcraft_get_story" ;
    :usesToolName "designcraft_render_page" .

app:use_case_run_commands a :UseCase ;
    :forApp app:app ;
    :usesToolName "designcraft_list_commands" ;
    :usesToolName "designcraft_execute" ;
    :usesToolName "designcraft_batch" ;
    :usesToolName "designcraft_export_png" .
