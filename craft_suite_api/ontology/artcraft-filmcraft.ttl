@prefix : <https://knuckles-team.github.io/ontology/connector/craft-common#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix app: <https://knuckles-team.github.io/ontology/connector/filmcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://knuckles-team.github.io/ontology/connector/filmcraft> a owl:Ontology ;
    rdfs:label "filmcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <https://knuckles-team.github.io/ontology/connector/craft-common> .

app:app a :App ;
    :appNamespace "filmcraft" ;
    :appVersion "0.17.0" .

app:FilmProject a owl:Class ;
    rdfs:label "FilmProject" ;
    rdfs:comment "A video editing project managed by FilmCraft." ;
    rdfs:subClassOf core:CreativeWork .

app:FilmSequence a owl:Class ;
    rdfs:label "FilmSequence" ;
    rdfs:comment "A sequence inside a FilmCraft project." ;
    rdfs:subClassOf core:CreativeWork .

app:use_case_import_and_sequence a :UseCase ;
    :forApp app:app ;
    :usesToolName "filmcraft_media_import" ;
    :usesToolName "filmcraft_project_inspect" ;
    :usesToolName "filmcraft_sequence_inspect" .

app:use_case_trim_sequence a :UseCase ;
    :forApp app:app ;
    :usesToolName "filmcraft_command_list" ;
    :usesToolName "filmcraft_command_run" ;
    :usesToolName "filmcraft_render_frame" .

app:use_case_inspect_project a :UseCase ;
    :forApp app:app ;
    :usesToolName "filmcraft_project_inspect" ;
    :usesToolName "filmcraft_sequence_inspect" ;
    :usesToolName "filmcraft_doc_inspect" .
