@prefix : <https://knuckles-team.github.io/ontology/connector/craft-common#> .
@prefix core: <https://knuckles-team.github.io/ontology/core#> .
@prefix app: <https://knuckles-team.github.io/ontology/connector/lightcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://knuckles-team.github.io/ontology/connector/lightcraft> a owl:Ontology ;
    rdfs:label "lightcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <https://knuckles-team.github.io/ontology/connector/craft-common> .

app:app a :App ;
    :appNamespace "lightcraft" ;
    :appVersion "0.18.1" .

app:PhotoLibrary a owl:Class ;
    rdfs:label "PhotoLibrary" ;
    rdfs:comment "A LightCraft photo library." ;
    rdfs:subClassOf core:Document .

app:DevelopedPhoto a owl:Class ;
    rdfs:label "DevelopedPhoto" ;
    rdfs:comment "A photo developed and exported by LightCraft." ;
    rdfs:subClassOf core:CreativeWork .

app:use_case_develop_photo a :UseCase ;
    :forApp app:app ;
    :usesToolName "lightcraft_import" ;
    :usesToolName "lightcraft_get_develop" ;
    :usesToolName "lightcraft_set_develop" ;
    :usesToolName "lightcraft_apply_preset" ;
    :usesToolName "lightcraft_export" .

app:use_case_query_library a :UseCase ;
    :forApp app:app ;
    :usesToolName "lightcraft_query_photos" ;
    :usesToolName "lightcraft_select_photos" ;
    :usesToolName "lightcraft_list_controls" ;
    :usesToolName "lightcraft_render_photo" .

app:use_case_run_commands a :UseCase ;
    :forApp app:app ;
    :usesToolName "lightcraft_list_commands" ;
    :usesToolName "lightcraft_command_list" ;
    :usesToolName "lightcraft_command_batch" ;
    :usesToolName "lightcraft_doc_inspect" .
