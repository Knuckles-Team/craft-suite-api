@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/anicraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/anicraft> a owl:Ontology ;
    rdfs:label "anicraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "anicraft" ;
    :appVersion "0.2.1" .

app:AnimationDocument a owl:Class ;
    rdfs:label "AnimationDocument" ;
    rdfs:comment "An AniCraft animation document (.anicraft), with its stage, scenes, layers, keyframes and library symbols." ;
    rdfs:subClassOf :CreativeWork .

app:use_case_inspect_document a :UseCase ;
    :forApp app:app ;
    :usesToolName "anicraft_anicraft_document" ;
    :usesToolName "anicraft_anicraft_commands" .

app:use_case_run_command a :UseCase ;
    :forApp app:app ;
    :usesToolName "anicraft_anicraft_commands" ;
    :usesToolName "anicraft_anicraft_run" .

app:use_case_run_script a :UseCase ;
    :forApp app:app ;
    :usesToolName "anicraft_anicraft_commands" ;
    :usesToolName "anicraft_anicraft_run_script" .

app:use_case_render_frame a :UseCase ;
    :forApp app:app ;
    :usesToolName "anicraft_anicraft_document" ;
    :usesToolName "anicraft_anicraft_render" .
