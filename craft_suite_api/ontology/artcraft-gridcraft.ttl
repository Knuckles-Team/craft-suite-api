@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/gridcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/gridcraft> a owl:Ontology ;
    rdfs:label "gridcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "gridcraft" ;
    :appVersion "0.16.1" .

app:Workbook a owl:Class ;
    rdfs:label "Workbook" ;
    rdfs:comment "A spreadsheet workbook edited by GridCraft." ;
    rdfs:subClassOf :Document .

app:CellRange a owl:Class ;
    rdfs:label "CellRange" ;
    rdfs:comment "A range of cells inside a GridCraft workbook." ;
    rdfs:subClassOf :Artifact .

app:use_case_edit_workbook a :UseCase ;
    :forApp app:app ;
    :usesToolName "gridcraft_new_workbook" ;
    :usesToolName "gridcraft_open_workbook" ;
    :usesToolName "gridcraft_write_range" ;
    :usesToolName "gridcraft_set_cell" ;
    :usesToolName "gridcraft_save_workbook" .

app:use_case_analyse_data a :UseCase ;
    :forApp app:app ;
    :usesToolName "gridcraft_read_range" ;
    :usesToolName "gridcraft_evaluate_formula" ;
    :usesToolName "gridcraft_create_table" ;
    :usesToolName "gridcraft_sort_range" ;
    :usesToolName "gridcraft_insert_chart" .

app:use_case_run_commands a :UseCase ;
    :forApp app:app ;
    :usesToolName "gridcraft_list_commands" ;
    :usesToolName "gridcraft_list_functions" ;
    :usesToolName "gridcraft_execute_command" ;
    :usesToolName "gridcraft_inspect_workbook" .
