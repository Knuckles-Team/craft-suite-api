@prefix : <http://knuckles.team/kg#> .
@prefix app: <http://knuckles.team/kg/artcraft/mailcraft#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://knuckles.team/kg/artcraft/mailcraft> a owl:Ontology ;
    rdfs:label "mailcraft" ;
    rdfs:comment "Generated by scripts/generate_app_content.py; do not edit." ;
    owl:imports <http://knuckles.team/kg/artcraft> .

app:app a :App ;
    :appNamespace "mailcraft" ;
    :appVersion "0.15.0" .

app:Mailbox a owl:Class ;
    rdfs:label "Mailbox" ;
    rdfs:comment "A MailCraft mailbox (.mailcraft), holding accounts, folders, messages, contacts, events and tasks." ;
    rdfs:subClassOf :Document .

app:use_case_open_mailbox a :UseCase ;
    :forApp app:app ;
    :usesToolName "mailcraft_open_mailbox" ;
    :usesToolName "mailcraft_status" ;
    :usesToolName "mailcraft_inspect_mailbox" ;
    :usesToolName "mailcraft_list_folders" .

app:use_case_read_messages a :UseCase ;
    :forApp app:app ;
    :usesToolName "mailcraft_list_folders" ;
    :usesToolName "mailcraft_list_messages" ;
    :usesToolName "mailcraft_read_message" .

app:use_case_send_message a :UseCase ;
    :forApp app:app ;
    :usesToolName "mailcraft_list_contacts" ;
    :usesToolName "mailcraft_send_message" .

app:use_case_save_mailbox a :UseCase ;
    :forApp app:app ;
    :usesToolName "mailcraft_save_mailbox" ;
    :usesToolName "mailcraft_inspect_mailbox" .
